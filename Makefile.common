# Jolt Physics
FLAGS += -I$(CORE_DIR)/vendor/jolt
SOURCES_CXX += $(wildcard \
	$(CORE_DIR)/vendor/jolt/Jolt/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Skeleton/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/AABBTree/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/ObjectStream/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/TriangleSplitter/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Core/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Math/*.cpp \
    $(CORE_DIR)/vendor/jolt/Jolt/Physics/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Physics/Ragdoll/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Physics/Vehicle/*.cpp \
    $(CORE_DIR)/vendor/jolt/Jolt/Physics/Collision/*.cpp \
    $(CORE_DIR)/vendor/jolt/Jolt/Physics/Collision/Broadphase/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Physics/Collision/Shape/*.cpp \
    $(CORE_DIR)/vendor/jolt/Jolt/Physics/Body/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Physics/Constraints/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Physics/SoftBody/*.cpp \
    $(CORE_DIR)/vendor/jolt/Jolt/Physics/Character/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Geometry/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Utilities/*.cpp \
	$(CORE_DIR)/vendor/jolt/Jolt/Renderer/*.cpp \
)
# Disable Jolt debug renderer to silence debug drawing and reduce overhead
# FLAGS += -DJPH_DEBUG_RENDERER=1

