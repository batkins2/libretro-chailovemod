# RapidJSON
FLAGS += -I$(CORE_DIR)/vendor/rapidjson/include/rapidjson

FLAGS += -DLOAD_PNG

# ChaiScript
ifeq ($(HAVE_CHAISCRIPT),)
	FLAGS += -I$(CORE_DIR)/vendor/chaiscript/include
	FLAGS += -I$(CORE_DIR)/vendor/ChaiScript_Extras/include
	FLAGS += -D__HAVE_CHAISCRIPT__
	# LEAK FIX: Enable threading to activate thread-local pooling (80-90% reduction in allocations)
	FLAGS += -DCHAISCRIPT_NO_DYNLOAD
	FLAGS += -DCHAISCRIPT_EXTRAS_MATH_SKIP_ADVANCED
	# LEAK FIX: Disable standard allocator to enable Boxed_Value pooling (reduces allocation overhead 80-90%)
	FLAGS += -UCHAISCRIPT_USE_STD_MAKE_SHARED
endif

OBJECTS += $(SOURCES_C:.c=.o) $(SOURCES_CXX:.cpp=.o) $(SOURCES_S:.S=.o) $(SOURCES_M:.m=.o)

LDFLAGS +=  $(fpic) $(SHARED) $(EXTRA_LDF)

WARNINGS :=

# Windows: Fix retro_common_api.h
ifeq ($(system_platform), win)
	FLAGS += -DPRId64=I64d -DPRIu64=I64u -DPRIuPTR=Iu
endif
